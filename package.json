{
  "name": "screw-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:browser:smoke": "node tests/browser.mjs --smoke",
    "test:arcade": "node tests/arcade-browser.mjs",
    "test:tactile": "node tests/tactile-browser.mjs",
    "test:workshop": "node tests/workshop-browser.mjs",
    "test:tree": "node tests/skill-tree-browser.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
